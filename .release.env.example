# Copy this file to .release.env (ignored by Git) and fill it in to sign and notarize the disk image.
# See Scripts/make-dmg.sh.
SIGN_IDENTITY=""   # SHA-1 fingerprint of your "Developer ID Application" certificate, or its full name
TEAM_ID=""         # your Apple Developer team ID
NOTARY_PROFILE=""  # name given to `xcrun notarytool store-credentials`
